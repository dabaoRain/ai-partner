# 将下面改成你的真实 Key
DEEPSEEK_API_KEY=

# JWT 密钥（生产必须更换）
JWT_SECRET=dev-change-me-ai-partner-jwt-secret

# CORS 白名单，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 可选：覆盖默认 SQLite 路径
# DATABASE_URL=sqlite:///./data/ai_partner.db

# 聊天超时（秒）
# CHAT_FIRST_TOKEN_TIMEOUT_SEC=90
# CHAT_STREAM_TIMEOUT_SEC=180
# CHAT_UPSTREAM_TIMEOUT_SEC=120
# CHAT_UPSTREAM_MAX_RETRIES=3
