{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "jsx": "preserve",
    "checkJs": false
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", "vite.config.js"]
}
